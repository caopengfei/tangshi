     {
      "c": "发",
      "py": "fā"
     },
     {
      "c": "几",
      "py": "jǐ"
     },
     {
      "c": "枝",
      "py": "zhī"
     }
    ]
   },
   {
    "text": "愿君多采撷，",
    "chars": [
     {
      "c": "愿",
      "py": "yuàn"
     },
     {
      "c": "君",
      "py": "jūn"
     },
     {
      "c": "多",
      "py": "duō"
     },
     {
      "c": "采",
      "py": "cǎi"
     },
     {
      "c": "撷",
      "py": "xié"
     }
    ]
   },
   {
    "text": "此物最相思。",
    "chars": [
     {
      "c": "此",
      "py": "cǐ"
     },
     {
      "c": "物",
      "py": "wù"
     },
     {
      "c": "最",
      "py": "zuì"
     },
     {
      "c": "相",
      "py": "xiāng"
     },
     {
      "c": "思",
      "py": "sī"
     }
    ]
   }
  ],
  "meaning": "红豆生长在南方，春天到了长出几根新枝。希望你多多采摘它，因为它最能代表深深的思念。"
 },
 {
  "id": "wang-lu-shan-pu-bu",
  "order": 7,
  "title": "望庐山瀑布",
  "poet": "李白",
  "dynasty": "唐",
  "background": "李白是唐朝大诗人，特别喜欢游山玩水。相传他来到庐山，远远看见瀑布从高高的山上直冲下来；阳光照着，香炉峰上升起了紫色的云烟。他觉得太神奇了，心想这难道是银河从九天之上落了下来吗？于是写下这首气势十足的《望庐山瀑布》。",
  "lines": [
