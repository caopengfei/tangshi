[
 {
  "id": "jing-ye-si",
  "order": 1,
  "title": "静夜思",
  "poet": "李白",
  "dynasty": "唐",
  "background": "李白年轻时离开家乡，长期在外游历。一个秋天的夜晚，他住在扬州的旅舍里，抬头看见窗外一轮皎洁的明月，月光洒在地上像一层白霜。他想：家乡的亲人是不是也在看着同一轮月亮呢？想念之下，写下了这首《静夜思》。",
  "lines": [
   {
    "text": "床前明月光，",
    "chars": [
     {
      "c": "床",
      "py": "chuáng"
     },
     {
      "c": "前",
      "py": "qián"
     },
     {
      "c": "明",
      "py": "míng"
     },
     {
      "c": "月",
      "py": "yuè"
     },
     {
      "c": "光",
      "py": "guāng"
     }
    ]
   },
   {
    "text": "疑是地上霜。",
    "chars": [
     {
      "c": "疑",
      "py": "yí"
     },
     {
      "c": "是",
      "py": "shì"
     },
     {
      "c": "地",
      "py": "dì"
     },
     {
      "c": "上",
      "py": "shàng"
     },
     {
      "c": "霜",
      "py": "shuāng"
     }
    ]
   },
   {
    "text": "举头望明月，",
    "chars": [
     {
      "c": "举",
      "py": "jǔ"
     },
     {
      "c": "头",
      "py": "tóu"
     },
     {
      "c": "望",
      "py": "wàng"
     },
     {
      "c": "明",
      "py": "míng"
     },
     {
      "c": "月",
      "py": "yuè"
     }
    ]
   },
   {
    "text": "低头思故乡。",
    "chars": [
     {
      "c": "低",
      "py": "dī"
     },
     {
      "c": "头",
      "py": "tóu"
     },
     {
      "c": "思",
      "py": "sī"
     },
     {
      "c": "故",
      "py": "gù"
     },
     {
      "c": "乡",
      "py": "xiāng"
     }
    ]
   }
  ],
  "meaning": "明亮的月光洒在床前，好像地上铺了一层白霜。抬起头望着天上的明月，低下头来思念远方的家乡。"
 },
 {
  "id": "yong-e",
  "order": 2,
  "title": "咏鹅",
  "poet": "骆宾王",
  "dynasty": "唐",
  "background": "骆宾王是唐朝的诗人。相传他七岁那年，看到家旁边池塘里白鹅在水上悠闲地游动，红红的脚掌拨动清清的水波，觉得又美又有趣，随口吟出了这首《咏鹅》。",
  "lines": [
   {
    "text": "鹅，鹅，鹅，",
