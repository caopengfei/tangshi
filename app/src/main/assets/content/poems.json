     },
     {
      "c": "流",
      "py": "liú"
     },
     {
      "c": "直",
      "py": "zhí"
     },
     {
      "c": "下",
      "py": "xià"
     },
     {
      "c": "三",
      "py": "sān"
     },
     {
      "c": "千",
      "py": "qiān"
     },
     {
      "c": "尺",
      "py": "chǐ"
     }
    ]
   },
   {
    "text": "疑是银河落九天。",
