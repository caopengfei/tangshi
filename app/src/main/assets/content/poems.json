      "c": "黄",
      "py": "huáng"
     },
     {
      "c": "河",
      "py": "hé"
     },
     {
      "c": "入",
      "py": "rù"
     },
     {
      "c": "海",
      "py": "hǎi"
     },
     {
      "c": "流",
      "py": "liú"
     }
    ]
   },
   {
    "text": "欲穷千里目，",
    "chars": [
     {
      "c": "欲",
      "py": "yù"
     },
     {
      "c": "穷",
      "py": "qióng"
     },
     {
      "c": "千",
      "py": "qiān"
     },
     {
      "c": "里",
      "py": "lǐ"
     },
     {
      "c": "目",
      "py": "mù"
     }
    ]
   },
   {
    "text": "更上一层楼。",
    "chars": [
     {
      "c": "更",
      "py": "gèng"
     },
     {
      "c": "上",
      "py": "shàng"
     },
     {
      "c": "一",
      "py": "yì"
     },
     {
      "c": "层",
      "py": "céng"
     },
     {
      "c": "楼",
      "py": "lóu"
     }
    ]
   }
  ],
  "meaning": "夕阳靠着远山慢慢落下去，黄河朝着大海滚滚奔流。要想看到千里之外的风光，就要再登上更高的一层楼。"
 },
 {
  "id": "xiang-si",
  "order": 6,
  "title": "相思",
  "poet": "王维",
  "dynasty": "唐",
  "background": "王维是唐朝诗人。红豆生长在南方，红红的果实很惹人喜爱，相传人们又叫它“相思子”，把它当作想念的象征。王维想念远方的朋友，就借这颗小小的红豆，请朋友多采一些带回去——看见红豆，就像看见了老朋友。这首小诗写的，就是这份深深的友情。",
  "lines": [
   {
    "text": "红豆生南国，",
    "chars": [
     {
      "c": "红",
      "py": "hóng"
     },
     {
      "c": "豆",
      "py": "dòu"
     },
     {
      "c": "生",
      "py": "shēng"
     },
     {
      "c": "南",
      "py": "nán"
     },
     {
      "c": "国",
      "py": "guó"
     }
    ]
   },
   {
    "text": "春来发几枝。",
    "chars": [
