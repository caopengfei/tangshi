   "poet": "孟浩然",
   "form": "五言律詩",
   "lines": [
    "木落雁南度，",
    "北风江上寒。",
    "我家襄水曲，",
    "遥隔楚云端。",
    "乡泪客中尽，",
    "孤帆天际看。",
    "迷津欲有问，",
    "平海夕漫漫。"
   ]
  },
