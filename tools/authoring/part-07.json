   "poet": "孟浩然",
   "form": "五言律詩",
   "lines": [
    "寂寂竟何待，",
    "朝朝空自归。",
    "欲寻芳草去，",
    "惜与故人违。",
    "当路谁相假，",
    "知音世所稀。",
    "只应守寂寞，",
    "还掩故园扉。"
   ]
  },
