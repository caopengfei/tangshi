   "title": "云阳馆与韩绅宿别",
   "poet": "司空曙",
   "form": "五言律詩",
   "lines": [
    "故人江海别，",
    "几度隔山川。",
    "乍见翻疑梦，",
    "相悲各问年。",
    "孤灯寒照雨，",
    "深竹暗浮烟。",
    "更有明朝恨，",
    "离杯惜共传。"
   ]
  },
