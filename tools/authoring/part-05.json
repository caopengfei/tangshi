   "title": "寄左省杜拾遗",
   "poet": "岑参",
   "form": "五言律詩",
   "lines": [
    "联步趋丹陛，",
    "分曹限紫微。",
    "晓随天仗入，",
    "暮惹御香归。",
    "白发悲花落，",
    "青云羡鸟飞。",
    "圣朝无阙事，",
    "自觉谏书稀。"
   ]
