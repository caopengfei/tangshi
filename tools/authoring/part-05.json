   "title": "赠孟浩然",
   "poet": "李白",
   "form": "五言律詩",
   "lines": [
    "吾爱孟夫子，",
    "风流天下闻。",
    "红颜弃轩冕，",
    "白首卧松云。",
    "醉月频中圣，",
    "迷花不事君。",
    "高山安可仰，",
    "徒此揖清芬。"
   ]
  },
