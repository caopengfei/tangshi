   "title": "夜泊牛渚怀古",
   "poet": "李白",
   "form": "五言律詩",
   "lines": [
    "牛渚西江夜，",
    "青天无片云。",
    "登舟望秋月，",
    "空忆谢将军。",
    "余亦能高咏，",
    "斯人不可闻。",
    "明朝挂帆席，",
    "枫叶落纷纷。"
   ]
  },
