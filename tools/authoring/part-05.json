   "poet": "王维",
   "form": "五言律詩",
   "lines": [
    "清川带长薄，",
    "车马去闲闲。",
    "流水如有意，",
    "暮禽相与还。",
    "荒城临古渡，",
    "落日满秋山。",
    "迢递嵩高下，",
    "归来且闭关。"
   ]
  },
  {
