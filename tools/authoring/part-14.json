   "title": "宿王昌龄隐居",
   "poet": "常建",
   "form": "五言古詩",
   "lines": [
    "清溪深不测，",
    "隐处唯孤云。",
    "松际露微月，",
    "清光犹为君。",
    "茅亭宿花影，",
    "药院滋苔纹。",
    "余亦谢时去，",
    "西山鸾鹤群。"
   ]
