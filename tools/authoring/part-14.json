   "poet": "韦应物",
   "form": "五言古詩",
   "lines": [
    "今朝郡斋冷，",
    "忽念山中客。",
    "涧底束荆薪，",
    "归来煮白石。",
    "欲持一瓢酒，",
    "远慰风雨夕。",
    "落叶满空山，",
    "何处寻行迹。"
   ]
