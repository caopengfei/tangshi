   "title": "晨诣超师院读禅经",
   "poet": "柳宗元",
   "form": "五言古詩",
   "lines": [
    "汲井漱寒齿，",
    "清心拂尘服。",
    "闲持贝叶书，",
    "步出东斋读。",
    "真源了无取，",
    "妄迹世所逐。",
    "遗言冀可冥，",
    "缮性何由熟。",
    "道人庭宇静，",
    "苔色连深竹。",
    "日出雾露余，",
    "青松如膏沐。",
    "澹然离言说，",
    "悟悦心自足。"
   ]
  },
