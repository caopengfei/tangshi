   "title": "夕次盱眙县",
   "poet": "韦应物",
   "form": "五言古詩",
   "lines": [
    "落帆逗淮镇，",
    "停舫临孤驿。",
    "浩浩风起波，",
    "冥冥日沉夕。",
    "人归山郭暗，",
    "雁下芦洲白。",
    "独夜忆秦关，",
    "听钟未眠客。"
   ]
  },
  {
   "id": "dong-jiao",
   "title": "东郊",
   "poet": "韦应物",
   "form": "五言古詩",
   "lines": [
    "吏舍跼终年，",
    "出郊旷清曙。",
    "杨柳散和风，",
    "青山澹吾虑。",
    "依丛适自憩，",
    "缘涧还复去。",
    "微雨霭芳原，",
    "春鸠鸣何处。",
    "乐幽心屡止，",
    "遵事迹犹遽。",
    "终罢斯结庐，",
    "慕陶直可庶。"
   ]
  },
  {
   "id": "jun-zhai-yu-zhong-yu-zhu-wen-shi-yan-ji",
   "title": "郡斋雨中与诸文士燕集",
   "poet": "韦应物",
   "form": "五言古詩",
   "lines": [
    "兵卫森画戟，",
    "宴寝凝清香。",
    "海上风雨至，",
    "逍遥池阁凉。",
    "烦疴近消散，",
    "嘉宾复满堂。",
    "自惭居处崇，",
    "未睹斯民康。",
    "理会是非遣，",
    "性达形迹忘。",
    "鲜肥属时禁，",
    "蔬果幸见尝。",
    "俯饮一杯酒，",
    "仰聆金玉章。",
    "神欢体自轻，",
    "意欲凌风翔。",
    "吴中盛文史，",
    "群彦今汪洋。",
    "方知大藩地，",
    "岂曰财赋强。"
   ]
  },
