  {
   "id": "su-ye-shi-shan-fang-dai-ding-da-bu-zhi",
   "title": "宿业师山房待丁大不至",
   "poet": "孟浩然",
   "form": "五言古詩",
   "lines": [
    "夕阳度西岭，",
    "群壑倏已暝。",
    "松月生夜凉，",
    "风泉满清听。",
    "樵人归欲尽，",
    "烟鸟栖初定。",
    "之子期宿来，",
    "孤琴候萝径。"
   ]
  },
  {
   "id": "xun-xi-shan-yin-zhe-bu-yu",
   "title": "寻西山隐者不遇",
   "poet": "丘为",
   "form": "五言古詩",
   "lines": [
    "绝顶一茅茨，",
    "直上三十里。",
    "扣关无僮仆，",
    "窥室唯案几。",
    "若非巾柴车，",
    "应是钓秋水。",
    "差池不相见，",
    "黾勉空仰止。",
    "草色新雨中，",
    "松声晚窗里。",
    "及兹契幽绝，",
    "自足荡心耳。",
    "虽无宾主意，",
    "颇得清净理。",
    "兴尽方下山，",
    "何必待之子。"
   ]
  },
  {
