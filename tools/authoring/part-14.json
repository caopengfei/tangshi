  {
   "id": "gan-yu-gu-hong-hai-shang-lai",
   "title": "感遇·孤鸿海上来",
   "poet": "张九龄",
   "form": "五言古詩",
   "lines": [
    "孤鸿海上来，",
    "池潢不敢顾。",
    "侧见双翠鸟，",
    "巢在三珠树。",
    "矫矫珍木巅，",
    "得无金丸惧？",
    "美服患人指，",
    "高明逼神恶。",
    "今我游冥冥，",
    "弋者何所慕！"
   ]
