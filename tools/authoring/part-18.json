   "poet": "李白",
   "form": "樂府",
   "lines": [
    "秦地罗敷女，",
    "采桑绿水边。",
    "素手青条上，",
    "红妆白日鲜。",
    "蚕饥妾欲去，",
    "五马莫留连。"
   ]
  },
  {
