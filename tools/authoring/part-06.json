   "title": "奉济驿重送严公四韵",
   "poet": "杜甫",
   "form": "五言律詩",
   "lines": [
    "远送从此别，",
    "青山空复情。",
    "几时杯重把，",
    "昨夜月同行。",
    "列郡讴歌惜，",
    "三朝出入荣。",
    "江村独归处，",
    "寂寞养残生。"
   ]
  },
  {
   "id": "bie-fang-tai-wei-mu",
   "title": "别房太尉墓",
   "poet": "杜甫",
   "form": "五言律詩",
   "lines": [
    "他乡复行役，",
    "驻马别孤坟。",
    "近泪无干土，",
    "低空有断云。",
    "对棋陪谢傅，",
    "把剑觅徐君。",
    "唯见林花落，",
    "莺啼送客闻。"
   ]
  },
  {
   "id": "lv-ye-shu-huai",
   "title": "旅夜书怀",
   "poet": "杜甫",
   "form": "五言律詩",
   "lines": [
    "细草微风岸，",
    "危樯独夜舟。",
    "星垂平野阔，",
    "月涌大江流。",
    "名岂文章著，",
    "官应老病休。",
    "飘飘何所似，",
    "天地一沙鸥。"
   ]
  },
  {
