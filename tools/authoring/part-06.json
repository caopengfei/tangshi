   "poet": "杜甫",
   "form": "五言律詩",
   "lines": [
    "此道昔归顺，",
    "西郊胡正繁。",
    "至今残破胆，",
    "应有未招魂。",
    "近得归京邑，",
    "移官岂至尊。",
    "无才日衰老，",
    "驻马望千门。"
   ]
