   "title": "春望",
   "poet": "杜甫",
   "form": "五言律詩",
   "lines": [
    "国破山河在，",
    "城春草木深。",
    "感时花溅泪，",
    "恨别鸟惊心。",
    "烽火连三月，",
    "家书抵万金。",
    "白头搔更短，",
    "浑欲不胜簪。"
   ]
