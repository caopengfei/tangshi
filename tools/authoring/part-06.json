   "title": "喜见外弟又言别",
   "poet": "李益",
   "form": "五言律詩",
   "lines": [
    "十年离乱后，",
    "长大一相逢。",
    "问姓惊初见，",
    "称名忆旧容。",
    "别来沧海事，",
    "语罢暮天钟。",
    "明日巴陵道，",
    "秋山又几重。"
   ]
