   "title": "月夜忆舍弟",
   "poet": "杜甫",
   "form": "五言律詩",
   "lines": [
    "戍鼓断人行，",
    "边秋一雁声。",
    "露从今夜白，",
    "月是故乡明。",
    "有弟皆分散，",
    "无家问死生。",
    "寄书长不达，",
    "况乃未休兵。"
   ]
  },
