   "poet": "王昌龄",
   "form": "五言古詩",
   "lines": [
    "高卧南斋时，",
    "开帷月初吐。",
    "清辉澹水木，",
    "演漾在窗户。",
    "冉冉几盈虚，",
    "澄澄变今古。",
    "美人清江畔，",
    "是夜越吟苦。",
    "千里共如何，",
    "微风吹兰杜。"
   ]
