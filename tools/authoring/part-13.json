   "poet": "王维",
   "form": "五言古詩",
   "lines": [
    "斜阳照墟落，",
    "穷巷牛羊归。",
    "野老念牧童，",
    "倚杖候荆扉。",
    "雉雊麦苗秀，",
    "蚕眠桑叶稀。",
    "田夫荷锄至，",
    "相见语依依。",
    "即此羡闲逸，",
    "怅然吟式微。"
   ]
  },
  {
   "id": "xi-shi-yong",
   "title": "西施咏",
   "poet": "王维",
   "form": "五言古詩",
   "lines": [
    "艳色天下重，",
    "西施宁久微。",
    "朝为越溪女，",
    "暮作吴宫妃。",
    "贱日岂殊众，",
    "贵来方悟稀。",
    "邀人傅香粉，",
    "不自著罗衣。",
    "君宠益娇态，",
    "君怜无是非。",
    "当时浣纱伴，",
    "莫得同车归。",
    "持谢邻家子，",
    "效颦安可希。"
   ]
  },
  {
   "id": "song-bie",
   "title": "送别",
   "poet": "王维",
   "form": "五言古詩",
   "lines": [
    "下马饮君酒，",
    "问君何所之？",
    "君言不得意，",
    "归卧南山陲。",
    "但去莫复问，",
    "白云无尽时。"
   ]
  },
  {
   "id": "song-qi-wu-qian-luo-di-huan-xiang",
   "title": "送綦毋潜落第还乡",
   "poet": "王维",
   "form": "五言古詩",
   "lines": [
    "圣代无隐者，",
    "英灵尽来归。",
    "遂令东山客，",
    "不得顾采薇。",
    "既至金门远，",
    "孰云吾道非。",
    "江淮度寒食，",
    "京洛缝春衣。",
    "置酒长安道，",
    "同心与我违。",
    "行当浮桂棹，",
    "未几拂荆扉。",
    "远树带行客，",
    "孤城当落晖。",
    "吾谋适不用，",
    "勿谓知音稀。"
   ]
  },
  {
   "id": "qing-xi",
   "title": "青溪",
   "poet": "王维",
   "form": "五言古詩",
   "lines": [
    "言入黄花川，",
    "每逐清溪水。",
    "随山将万转，",
    "趣途无百里。",
    "声喧乱石中，",
    "色静深松里。",
    "漾漾泛菱荇，",
    "澄澄映葭苇。",
    "我心素已闲，",
    "清川澹如此。",
    "请留磐石上，",
    "垂钓将已矣。"
   ]
